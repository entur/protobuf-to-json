<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.entur.protobuf-to-json</groupId>
        <artifactId>protobuf-to-json-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>protobuf-to-json-utility</artifactId>
    <name>protobuf-to-json-utility</name>
    <description>Checks that a writer writes the same JSON as JsonFormat, and a writer which uses JsonFormat (Jackson 3)</description>

    <dependencies>
        <dependency>
            <groupId>no.entur.protobuf-to-json</groupId>
            <artifactId>protobuf-to-json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
        </dependency>
        <dependency>
            <!-- for compiling the module descriptor, which requires com.google.gson; provided, as at runtime gson comes
                 from protobuf-java-util, in the version protobuf-java-util depends on -->
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <dependency>
            <groupId>no.entur.protobuf-to-json</groupId>
            <artifactId>protobuf-to-json-test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
