<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.entur.protobuf-to-json</groupId>
        <artifactId>protobuf-to-json-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>protobuf-to-json-lite</artifactId>
    <name>protobuf-to-json-lite</name>
    <description>Writes protobuf lite messages as JSON (Jackson 2, Android compatible)</description>

    <properties>
        <!-- also used on Android -->
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>no.entur.protobuf-to-json</groupId>
            <artifactId>protobuf-to-json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-javalite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>no.entur.protobuf-to-json</groupId>
            <artifactId>protobuf-to-json-api</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- the reference filter parses with Jackson 3 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-test-messages</id>
                        <goals>
                            <goal>generate-test</goal>
                        </goals>
                        <configuration>
                            <liteOnly>true</liteOnly>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the test messages as files, with the JsonFormat output, written from the full protobuf messages of the test-support module -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>write-payloads</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>no.entur.protobuf.json.test.PayloadFiles</mainClass>
                            <!-- the full protobuf runtime only on the classpath of the plugin, not on the lite classpath -->
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>no.entur.protobuf-to-json</groupId>
                                <artifactId>protobuf-to-json-test-support</artifactId>
                            </executableDependency>
                            <arguments>
                                <argument>${project.build.testOutputDirectory}/payloads</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>no.entur.protobuf-to-json</groupId>
                        <artifactId>protobuf-to-json-test-support</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <!-- the lite test messages are reused by the lite benchmarks -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Android: older tools fail on a module-info.class at the root of a jar, so it is only in
                             META-INF/versions/9. target/classes keeps it at the root, for builds which compile the other
                             modules without packaging. -->
                        <id>default-jar</id>
                        <configuration>
                            <excludes>
                                <exclude>module-info.class</exclude>
                            </excludes>
                            <archive>
                                <manifestEntries>
                                    <Multi-Release>true</Multi-Release>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- the module descriptor, also for Java 9 in META-INF/versions/9 (see the jar plugin) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>module-descriptor-java-9</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>9</release>
                            <multiReleaseOutput>true</multiReleaseOutput>
                            <includes>
                                <include>module-info.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
